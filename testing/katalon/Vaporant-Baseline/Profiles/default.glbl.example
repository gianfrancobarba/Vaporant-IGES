<?xml version="1.0" encoding="UTF-8"?>
<GlobalVariableEntities>
   <description>TEMPLATE del profilo di esecuzione. Copiare questo file in 'default.glbl' (stessa cartella) e adattare i valori macchina-specifici (mysqlExe, dbUser, dbPass) al proprio ambiente. Il file 'default.glbl' NON e' versionato (cfr. .gitignore).</description>
   <name>default</name>
   <tag></tag>
   <defaultProfile>true</defaultProfile>
   <GlobalVariableEntity>
      <description>URL base dell'applicazione Vaporant (context Tomcat). Cambiare SOLO qui se il context e' diverso.</description>
      <initValue>'http://localhost:8080/Vaporant_IGES_war_exploded/'</initValue>
      <name>base</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Percorso del client mysql (usato dalla fixture SeedReset per ripristinare il seed). Adattare alla propria installazione MySQL. Esempi: Windows 'C:\\Program Files\\MySQL\\MySQL Server 8.0\\bin\\mysql.exe' · macOS '/opt/homebrew/bin/mysql' · Linux '/usr/bin/mysql'.</description>
      <initValue>'PERCORSO_ASSOLUTO_AL_CLIENT_MYSQL'</initValue>
      <name>mysqlExe</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Utente del database (fixture di reset).</description>
      <initValue>'root'</initValue>
      <name>dbUser</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Password del database (fixture di reset). Inserire la propria password locale di MySQL.</description>
      <initValue>'LA_TUA_PASSWORD_MYSQL'</initValue>
      <name>dbPass</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Nome dello schema del database (fixture di reset).</description>
      <initValue>'storage'</initValue>
      <name>dbName</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Porta TCP del database per la fixture di reset. '3306' per il MySQL locale (deploy IntelliJ); '3307' per la regressione contro il container (docker-compose.test.yml mappa 3307 -> 3306).</description>
      <initValue>'3306'</initValue>
      <name>dbPort</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Se true, la fixture SeedReset ripristina il seed prima di ogni test (indipendenza/ripetibilita'). Mettere false per disattivarla.</description>
      <initValue>true</initValue>
      <name>resetSeed</name>
   </GlobalVariableEntity>
</GlobalVariableEntities>
